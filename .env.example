# Copy to .env and adjust. Every setting uses the LEAKHUNTER_ prefix.

# LLM: "scripted" (deterministic, no key needed) or "anthropic"
LEAKHUNTER_LLM_PROVIDER=scripted
LEAKHUNTER_MODEL=claude-opus-5-5
LEAKHUNTER_EFFORT=medium
LEAKHUNTER_LLM_FALLBACKS=true
# Required only for LEAKHUNTER_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Pinned clock so fixture freshness checks are reproducible (empty = system clock)
LEAKHUNTER_NOW=2026-11-02T09:00:00Z
LEAKHUNTER_CURRENT_PERIOD=2026-10

# API keys (comma-separated)
LEAKHUNTER_VIEWER_KEYS=viewer-dev-key
LEAKHUNTER_OPERATOR_KEYS=operator-dev-key

LEAKHUNTER_LOG_LEVEL=INFO
LEAKHUNTER_LOG_JSON=true
